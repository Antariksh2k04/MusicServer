{
  "name": "music-server-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:native-shell": "tsc --noEmit && vite build --config vite.native.config.ts",
    "android:sync": "npm run build:native-shell && cap sync android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@ionic/react": "9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@capacitor/cli": "8.5.2"
  }
}
